#!/usr/bin/env node
/**
 * Local dev wrapper for opencode from source.
 * Cleans up zombie processes before starting.
 */

import { spawn, execSync } from "child_process"
import { fileURLToPath } from "url"
import path from "path"

const __dirname = path.dirname(fileURLToPath(import.meta.url))
const src = path.join(__dirname, "..", "src", "index.ts")

const bunPath = process.platform === "win32"
  ? "C:\\Users\\sathv\\AppData\\Roaming\\npm\\bun.cmd"
  : "bun"

// Kill any existing bun processes on port 4096
if (process.platform === "win32") {
  try {
    execSync(
      `for /f "tokens=5" %a in ('netstat -ano ^| findstr :4096 ^| findstr LISTENING') do taskkill /F /PID %a 2>nul`,
      { shell: "cmd.exe", stdio: "ignore" }
    )
  } catch {
    // Ignore errors if no process found
  }
}

const child = spawn(
  bunPath,
  ["run", "--conditions=browser", src, ...process.argv.slice(2)],
  {
    stdio: "inherit",
    shell: process.platform === "win32",
  },
)

child.on("error", (err) => {
  console.error(err.message)
  process.exit(1)
})

child.on("exit", (code) => {
  process.exit(code ?? 0)
})
