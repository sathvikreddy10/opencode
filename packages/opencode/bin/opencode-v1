#!/usr/bin/env node
/**
 * Local dev wrapper for opencode from source.
 * Smart: attaches to existing backend or starts standalone TUI.
 */

import { spawn, execSync } from "child_process"
import { fileURLToPath } from "url"
import path from "path"

const __dirname = path.dirname(fileURLToPath(import.meta.url))
const src = path.join(__dirname, "..", "src", "index.ts")

const bunPath = process.platform === "win32"
  ? "C:\\Users\\sathv\\AppData\\Roaming\\npm\\bun.cmd"
  : "bun"

function isBackendRunning() {
  if (process.platform !== "win32") return false
  try {
    const result = execSync(
      'netstat -ano | findstr :4096 | findstr LISTENING',
      { shell: "cmd.exe", stdio: ["pipe", "pipe", "pipe"] }
    )
    return result.length > 0
  } catch {
    return false
  }
}

const backendRunning = isBackendRunning()
const args = process.argv.slice(2)
const cmdArgs = backendRunning
  ? ["run", "--conditions=browser", src, "attach", "http://localhost:4096", ...args]
  : ["run", "--conditions=browser", src, ...args]

if (backendRunning) {
  console.log("[opencode-v1] Backend detected on port 4096, attaching TUI...")
} else {
  console.log("[opencode-v1] Starting TUI with embedded server...")
}

const child = spawn(
  bunPath,
  cmdArgs,
  {
    stdio: "inherit",
    shell: process.platform === "win32",
  },
)

child.on("error", (err) => {
  console.error(err.message)
  process.exit(1)
})

child.on("exit", (code) => {
  process.exit(code ?? 0)
})
